{
  "manifest_version": 3,
  "name": "𝕏-Bar",
  "version": "0.5.3",
  "description": "__MSG_description__",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "action": {
    "default_title": "__MSG_action_title__",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'none'; object-src 'none'"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "default_locale": "en"
}
